# Copy this file to local.env or .env.local, then fill in your Etsy app values.
#
# Etsy Developer app:
# https://developer.etsy.com/

ETSY_CLIENT_ID=your_etsy_keystring
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback
ETSY_SCOPES=address_r address_w billing_r cart_r cart_w email_r favorites_r favorites_w feedback_r listings_d listings_r listings_w profile_r profile_w recommend_r recommend_w shops_r shops_w transactions_r transactions_w
ETSY_WEBHOOK_SECRET=optional_etsy_webhook_signing_secret

# Local app URL used by buttons and OAuth redirect checks.
APP_URL=http://localhost:3000
SYNC_CRON_SECRET=optional_secret_for_cron_and_worker_routes

# PostgreSQL is required for webhook events, queued sync jobs, and structured order storage.
# Replace password with your local postgres password.
DATABASE_URL=postgresql://postgres:password@localhost:5432/etsy_saas

# Optional: needed when Node.js must reach Etsy through a local proxy/VPN.
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1
